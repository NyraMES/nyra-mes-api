# Production API — copy to .env.production before deploy to nyraservices-testbed.net/mes/api

MES_CORE_ENABLED=true
MES_CORE_DB_HOST=nyra-mes-core.ct6oskiisvfb.eu-north-1.rds.amazonaws.com
MES_CORE_DB_PORT=5432
MES_CORE_DB_NAME=postgres
MES_CORE_DB_USER=mescore
# Preferred on testbed — password fetched at runtime from Secrets Manager (no stale copy in .env).
MES_CORE_DB_SECRET_ID=rds!db-REPLACE-WITH-YOUR-RDS-SECRET-NAME
MES_CORE_AWS_REGION=eu-north-1
# Local dev fallback only — leave empty when MES_CORE_DB_SECRET_ID is set.
MES_CORE_DB_PASSWORD=
DEFAULT_TENANT_CODE=AUTO_OEM_DEMO

LEGACY_DB_ENABLED=false

CORS_ALLOW_ORIGINS=https://nyraservices-testbed.net,http://nyraservices-testbed.net

AUTH_ENABLED=true
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=eu-north-1_511qizpPW
COGNITO_APP_CLIENT_ID=rsvrimdato29cl5e0l06gsvp1

AUTH_DEV_USER_EMAIL=dev@localhost
AUTH_DEV_USER_ROLES=MES_Admin
