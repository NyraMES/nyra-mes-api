# nyra_mes_core — sole active database
MES_CORE_ENABLED=true
MES_CORE_DB_HOST=your-mes-core-host.rds.amazonaws.com
MES_CORE_DB_PORT=5432
MES_CORE_DB_NAME=nyra_mes_core
MES_CORE_DB_USER=mescore
MES_CORE_DB_PASSWORD=your-mes-core-password
DEFAULT_TENANT_CODE=AUTO_OEM_DEMO

# Legacy oemauto — disabled by default; legacy route code kept until cleanup
LEGACY_DB_ENABLED=false
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# CORS (comma-separated frontend origins)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS Cognito — set AUTH_ENABLED=true in production
AUTH_ENABLED=false
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Used only when AUTH_ENABLED=false (local dev without Cognito)
AUTH_DEV_USER_EMAIL=dev@localhost
AUTH_DEV_USER_ROLES=MES_Admin
AUTH_DEV_USER_TENANT_CODE=

# Domain → tenant bindings for SPA (host=tenant[:workspace][:industry], comma-separated)
# Industry-only dev host: ac.localhost uses SAM_CARBONS_DEMO (generic AC playground).
# Client host example: ac.client.com=CLIENT_TENANT:CLIENT_WORKSPACE:activated-carbon
HOST_TENANT_MAP=
