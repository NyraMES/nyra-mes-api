# Attach this policy to the EC2 instance role for nyraservices-testbed (51.20.17.160).
# Allows nyra-mes-api to read the RDS master secret at runtime (MES_CORE_DB_SECRET_ID).
#
# AWS Console → EC2 → Instance → Actions → Security → Modify IAM role
# Or IAM → Roles → <ec2-role> → Add inline policy (paste Resource ARN from Secrets Manager).

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MesCoreRdsSecretRead",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:eu-north-1:*:secret:rds!db-*"
    }
  ]
}
