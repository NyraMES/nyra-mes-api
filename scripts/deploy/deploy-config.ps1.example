# Copy to deploy-config.ps1 and set paths for your machine.
# deploy-config.ps1 is gitignored — do not commit keys or host overrides.

$TestbedHost = "51.20.17.160"
$TestbedUser = "ubuntu"
$SshKeyPath = "D:\path\to\nyraservices.pem"

# Remote paths on testbed EC2
$RemoteApiDir = "/home/ubuntu/nyra-mes-api"
$RemoteUiDir = "/home/ubuntu/testbed/tenants/mes"
$RemoteApiService = "nyra-mes-api"
$RemoteApiPort = "8010"

# RDS Secrets Manager — password fetched at runtime (no stale copy in server .env).
# nyra-mes-core master secret (eu-north-1). EC2 needs scripts/iam/ec2-mes-core-secret-read.json.
$MesCoreDbSecretId = "rds!db-36663457-9b38-40d7-a4e7-bb4b65ac1f79"
