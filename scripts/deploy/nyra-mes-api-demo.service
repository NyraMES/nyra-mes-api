[Unit]
Description=Nyra MES API demo database (FastAPI)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nyra-mes-api
EnvironmentFile=/home/ubuntu/nyra-mes-api/.env.demo
ExecStart=/home/ubuntu/nyra-mes-api/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8011
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
