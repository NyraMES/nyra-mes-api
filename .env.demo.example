# =============================================================================
# Nyra Video Demo environment — copy to .env.demo and fill DB password
# =============================================================================
# Usage:
#   copy .env.demo.example .env.demo
#   # Add MES_CORE_DB_PASSWORD from your RDS secret (same host as dev)
#   .\scripts\run_video_demo.ps1
#
# This tenant uses FICTIONAL data only (Apex Automotive, LOT-DEMO-*).
# Safe to share demo-viewer login with video tools — NOT production credentials.
# =============================================================================

MES_CORE_ENABLED=true
MES_CORE_DB_HOST=your-mes-core-host.rds.amazonaws.com
MES_CORE_DB_PORT=5432
MES_CORE_DB_NAME=nyra_mes_core
MES_CORE_DB_USER=mescore
MES_CORE_DB_PASSWORD=

# Point all API requests at the isolated video-demo tenant
DEFAULT_TENANT_CODE=NYRA_VIDEO_DEMO

LEGACY_DB_ENABLED=false

# Local demo mode — no Cognito password required (frontend may still need config)
AUTH_ENABLED=false
AUTH_DEV_USER_EMAIL=demo-viewer@nyra-demo.local
AUTH_DEV_USER_ROLES=MES_Planner

# Frontend origins allowed (add your hosted demo UI URL when deployed)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prospect-safe: hide Swagger, block ontology/KG, read-only API (Ask Nyra still works)
DEMO_MODE=true
DEMO_READ_ONLY=true

# --- Hosted demo with Cognito (optional) ---
# AUTH_ENABLED=true
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=your-pool-id
# COGNITO_APP_CLIENT_ID=your-client-id
# Then run: .\scripts\provision_demo_cognito_user.ps1
# Login: demo-viewer@nyra-demo.local / (password printed by script — rotate after video)
